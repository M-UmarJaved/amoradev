# ============================================================
# Zamra Tech — Production Server Configuration (.htaccess)
# ============================================================

# 1. Serve modern static homepage before any PHP index
DirectoryIndex index.html index.php

# 2. Security Headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-XSS-Protection "1; mode=block"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 3. High-Performance Browser Caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 1 hour"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
</IfModule>

# 4. Gzip / Deflate Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>

# 5. URL Rewriting & Clean Routing
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 301 Redirect legacy /work to /portfolio/
  RewriteRule ^work/?$ /portfolio/ [R=301,L]
  # 301 Redirect legacy maintenance url
  RewriteRule ^services/software-mobile-app-maintenance/?$ /maintenance/ [R=301,L]

  # Allow existing directories and files to serve directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Clean URLs: if an html file exists matching request, serve it
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.*)/?$ /$1.html [L]
</IfModule>

# 6. Custom 404 Error Page
ErrorDocument 404 /404.html

# 7. Protect logs and sensitive files
<FilesMatch "(leads\.log|\.git|\.env|\.sql)$">
  Order allow,deny
  Deny from all
</FilesMatch>
